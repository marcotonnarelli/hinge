# Per-laptop GitHub PATs (2-3 recommended; only those that are set will be used).
GH_TOKEN_1=
GH_TOKEN_2=
GH_TOKEN_3=

# Identifies this laptop's output DB: mining_<LAPTOP_ID>.db
LAPTOP_ID=A

# Half-open window [DATE_FROM, DATE_TO). Suggested split:
#   Laptop A: 2022-11-01 .. 2024-01-01  (14 months)
#   Laptop B: 2024-01-01 .. 2025-03-01  (14 months)
#   Laptop C: 2025-03-01 .. 2026-06-01  (15 months)
DATE_FROM=2022-11-01
DATE_TO=2024-01-01

# Phase 1 (discovery) only.
MIN_STARS=1000

# Optional: cap the number of repos processed per run (useful for dry runs).
# REPO_LIMIT=20
