        </mxCell>
        <mxCell id="14" value="&lt;b&gt;Lookup API&lt;/b&gt;&lt;br&gt;get_reader(name, **kwargs) → instance&lt;br&gt;get_store(name, read_only) → instance&lt;br&gt;get_projection(name, **kwargs) → instance&lt;br&gt;get_exporter(name, **kwargs) → instance&lt;br&gt;list_registered(role) → list[str]" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="12" vertex="1">
          <mxGeometry x="420" y="35" width="450" height="100" as="geometry" />
