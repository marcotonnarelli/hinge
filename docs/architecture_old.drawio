        <mxCell id="13" value="&lt;b&gt;Entry-point discovery&lt;/b&gt;&lt;br&gt;importlib.metadata.entry_points()&lt;br&gt;Scans all installed packages at startup&lt;br&gt;Groups: hinge.readers · hinge.stores&lt;br&gt;hinge.projections · hinge.exporters" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="12" vertex="1">
