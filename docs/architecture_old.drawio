          <mxGeometry x="10" y="205" width="880" height="210" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;b&gt;run_ingest(reader, store, schema)&lt;/b&gt;&lt;br&gt;① dataset_id = uuid4().hex&lt;br&gt;② store.begin_dataset(dataset_id, …)&lt;br&gt;③ iter elements → validate vs HINSchema&lt;br&gt;     invalid type → SchemaViolation&lt;br&gt;④ batch-upsert every 5 000 elements&lt;br&gt;⑤ store.finalise_dataset(dataset_id, n, e)&lt;br&gt;→ IngestReport(dataset_id, nodes, edges, violations)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="15" vertex="1">
          <mxGeometry x="10" y="35" width="270" height="165" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;b&gt;run_projection(proj, spec, dataset_id)&lt;/b&gt;&lt;br&gt;Calls projection.run(spec, params, dataset_id)&lt;br&gt;&lt;br&gt;→ ProjectedGraphHandle&lt;br&gt;  (lazy cursor over materialised&lt;br&gt;   DuckDB result table)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="15" vertex="1">
          <mxGeometry x="295" y="35" width="270" height="165" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;b&gt;run_export(handle, exporter, sink)&lt;/b&gt;&lt;br&gt;Calls exporter.write(handle, sink)&lt;br&gt;&lt;br&gt;Computes snapshot_id:&lt;br&gt;sha256(store.fingerprint()&lt;br&gt;     + proj.fingerprint()&lt;br&gt;     + schema_version&lt;br&gt;     + tool_version)&lt;br&gt;→ ExportReceipt" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="15" vertex="1">
          <mxGeometry x="580" y="35" width="290" height="165" as="geometry" />
        </mxCell>
