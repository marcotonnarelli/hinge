          <mxGeometry x="10" y="435" width="880" height="165" as="geometry" />
        </mxCell>
        <mxCell id="20" value="&lt;b&gt;NodeType&lt;/b&gt;&lt;br&gt;StrEnum&lt;br&gt;user · repo&lt;br&gt;artifact" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="19" vertex="1">
          <mxGeometry x="10" y="35" width="110" height="115" as="geometry" />
        </mxCell>
        <mxCell id="21" value="&lt;b&gt;EdgeType&lt;/b&gt;&lt;br&gt;StrEnum&lt;br&gt;opened · reviewed&lt;br&gt;merged · pushed&lt;br&gt;commented_on&lt;br&gt;…15 types" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="19" vertex="1">
          <mxGeometry x="130" y="35" width="120" height="115" as="geometry" />
        </mxCell>
        <mxCell id="22" value="&lt;b&gt;TypedNode&lt;/b&gt;&lt;br&gt;Pydantic BaseModel&lt;br&gt;type: NodeType&lt;br&gt;id: str&lt;br&gt;ts: datetime&lt;br&gt;attrs: dict" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="19" vertex="1">
          <mxGeometry x="260" y="35" width="130" height="115" as="geometry" />
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;TypedEdge&lt;/b&gt;&lt;br&gt;Pydantic BaseModel&lt;br&gt;type: EdgeType&lt;br&gt;src_id · dst_id&lt;br&gt;ts: datetime&lt;br&gt;attrs: dict" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="19" vertex="1">
          <mxGeometry x="400" y="35" width="130" height="115" as="geometry" />
        </mxCell>
        <mxCell id="24" value="&lt;b&gt;SchemaViolation&lt;/b&gt;&lt;br&gt;Pydantic BaseModel&lt;br&gt;code · message&lt;br&gt;source · line&lt;br&gt;Yielded instead of&lt;br&gt;raising exceptions" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="19" vertex="1">
          <mxGeometry x="540" y="35" width="140" height="115" as="geometry" />
        </mxCell>
        <mxCell id="25" value="&lt;b&gt;HINSchema&lt;/b&gt;&lt;br&gt;Pydantic · from types.yaml&lt;br&gt;node_types · edge_types&lt;br&gt;allows_node(NodeType) → bool&lt;br&gt;allows_edge(EdgeType) → bool&lt;br&gt;Gates every element in run_ingest" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="19" vertex="1">
          <mxGeometry x="690" y="35" width="180" height="115" as="geometry" />
        </mxCell>
        <mxCell id="27" value="Protocols · protocols/  (structural — no inheritance required)" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;fontColor=#333333;" parent="11" vertex="1">
          <mxGeometry x="10" y="620" width="880" height="150" as="geometry" />
        </mxCell>
        <mxCell id="28" value="&lt;b&gt;ReaderStage&lt;/b&gt;&lt;br&gt;iter_elements()&lt;br&gt;→ Iterator[TypedNode |&lt;br&gt;TypedEdge | SchemaViolation]&lt;br&gt;describe() → ReaderDescriptor" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="27" vertex="1">
          <mxGeometry x="10" y="35" width="195" height="105" as="geometry" />
        </mxCell>
        <mxCell id="29" value="&lt;b&gt;StoreStage&lt;/b&gt;&lt;br&gt;begin_dataset(id, reader, path)&lt;br&gt;finalise_dataset(id, n, e)&lt;br&gt;upsert(nodes, edges) → int&lt;br&gt;fingerprint() · census()&lt;br&gt;list_datasets() → list[DatasetMeta]" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="27" vertex="1">
          <mxGeometry x="215" y="35" width="205" height="105" as="geometry" />
        </mxCell>
        <mxCell id="30" value="&lt;b&gt;ProjectionStage&lt;/b&gt;&lt;br&gt;run(spec_name, params, dataset_id)&lt;br&gt;→ ProjectedGraphHandle&lt;br&gt;fingerprint() → EngineFingerprint&lt;br&gt;(hash of all .sql + .yml files)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="27" vertex="1">
          <mxGeometry x="430" y="35" width="210" height="105" as="geometry" />
        </mxCell>
        <mxCell id="31" value="&lt;b&gt;ExporterStage&lt;/b&gt;&lt;br&gt;write(handle, sink: BinaryIO)&lt;br&gt;→ ExportReceipt(format,&lt;br&gt;content_hash, schema_version,&lt;br&gt;node_count, edge_count)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="27" vertex="1">
          <mxGeometry x="650" y="35" width="220" height="105" as="geometry" />
        </mxCell>
        <mxCell id="32" value="Projection value objects · projection/" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;fontColor=#333333;" parent="11" vertex="1">
          <mxGeometry x="10" y="790" width="880" height="100" as="geometry" />
        </mxCell>
        <mxCell id="33" value="&lt;b&gt;ProjectionSpec&lt;/b&gt;&lt;br&gt;name (CLI key) · description&lt;br&gt;model_name (SQL file stem)&lt;br&gt;output_node/edge_types" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="32" vertex="1">
          <mxGeometry x="10" y="35" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="34" value="&lt;b&gt;BUILTIN_PROJECTIONS&lt;/b&gt;&lt;br&gt;Tuple of ProjectionSpec constants&lt;br&gt;user-user-repo-collaboration → dev_interaction.sql" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="32" vertex="1">
          <mxGeometry x="265" y="35" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="35" value="&lt;b&gt;ProjectedGraphHandle&lt;/b&gt; (Protocol)&lt;br&gt;iter_nodes() · iter_edges()&lt;br&gt;Impl: _CursorHandle streams DuckDB rows" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" parent="32" vertex="1">
          <mxGeometry x="580" y="35" width="290" height="55" as="geometry" />
        </mxCell>
        <mxCell id="85" value="returns" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;html=1;" parent="11" source="30" target="35" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="36" value="hinge.stages — concrete implementations · registered via pyproject.toml entry-points" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="1250" y="185" width="790" height="900" as="geometry">
            <mxRectangle x="1250" y="185" width="485" height="30" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="37" value="Readers · stages/readers/" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;fontColor=#333333;" parent="36" vertex="1">
          <mxGeometry x="10" y="40" width="770" height="205" as="geometry" />
        </mxCell>
        <mxCell id="38" value="&lt;b&gt;NumFocusReader&lt;/b&gt;&lt;br&gt;JSONL · CSV · Parquet (format auto-detected from extension)&lt;br&gt;ACTION_MAP: action string → (EdgeType, artifact_kind)&lt;br&gt;Per record:&lt;br&gt;  yield TypedNode for actor + repo + artifact&lt;br&gt;  yield TypedEdge (user→artifact or user→repo)&lt;br&gt;  yield TypedEdge CONTAINS (repo→artifact)&lt;br&gt;  yield SchemaViolation on unknown/missing field&lt;br&gt;Subclass: override ACTION_MAP or any _extract_* method" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;html=1;" parent="37" vertex="1">
          <mxGeometry x="10" y="35" width="570" height="160" as="geometry" />
        </mxCell>
        <mxCell id="39" value="&lt;b&gt;_format_utils.py&lt;/b&gt;&lt;br&gt;Shared parsing helpers&lt;br&gt;iter_jsonl(path)&lt;br&gt;iter_csv(path)&lt;br&gt;iter_parquet(path)&lt;br&gt;yield (dict, line_number)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;html=1;" parent="37" vertex="1">
          <mxGeometry x="595" y="35" width="165" height="160" as="geometry" />
        </mxCell>
        <mxCell id="40" value="Store · stages/store/" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;fontColor=#333333;" parent="36" vertex="1">
          <mxGeometry x="10" y="265" width="770" height="190" as="geometry" />
        </mxCell>
        <mxCell id="41" value="&lt;b&gt;DuckDBStore · schema v2&lt;/b&gt;&lt;br&gt;─── Tables ─────────────────────────────────────────────────────────&lt;br&gt;meta        key=schema_version · value=2&lt;br&gt;datasets    dataset_id · reader · path · ingested_at · node_count · edge_count&lt;br&gt;nodes       dataset_id · type · id · ts · attrs (JSON)&lt;br&gt;edges       dataset_id · type · src_id · dst_id · ts · attrs (JSON)&lt;br&gt;─────────────────────────────────────────────────────────────────────&lt;br&gt;begin_dataset() inserts row into datasets · upsert() uses active dataset_id&lt;br&gt;fingerprint() = sha256(md5 of all node+edge identifiers)&lt;br&gt;read_only=True when opened for fingerprinting (avoids lock conflict with dbt)&lt;br&gt;Raises SchemaMismatchError if stored version ≠ current_version" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;html=1;" parent="40" vertex="1">
          <mxGeometry x="10" y="35" width="750" height="145" as="geometry" />
        </mxCell>
        <mxCell id="42" value="Projection · stages/projection/" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;fontColor=#333333;" parent="36" vertex="1">
          <mxGeometry x="10" y="475" width="770" height="215" as="geometry" />
        </mxCell>
        <mxCell id="43" value="&lt;b&gt;DbtProjection&lt;/b&gt;&lt;br&gt;① CREATE OR REPLACE VIEW active_nodes AS&lt;br&gt;     SELECT type, id, ts, attrs FROM nodes&lt;br&gt;     WHERE dataset_id = &#39;&lt;id&gt;&#39;&lt;br&gt;   CREATE OR REPLACE VIEW active_edges AS&lt;br&gt;     SELECT … FROM edges WHERE dataset_id = &#39;&lt;id&gt;&#39;&lt;br&gt;② subprocess: dbt run --select &lt;model&gt;&lt;br&gt;   stdout → DEBUG log per line&lt;br&gt;   stderr → ERROR log on failure&lt;br&gt;③ return _CursorHandle(db_path, table_name)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;html=1;" parent="42" vertex="1">
          <mxGeometry x="10" y="35" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="44" value="&lt;b&gt;models/&lt;/b&gt;&lt;br&gt;sources.yml → declares active_nodes + active_edges&lt;br&gt;(these are dataset-filtered views, never raw tables)&lt;br&gt;&lt;br&gt;dev_interaction.sql&lt;br&gt;{{ source(&#39;hin&#39;, &#39;active_nodes&#39;) }}  /  active_edges&lt;br&gt;PR opener ↔ reviewer / commenter / merger&lt;br&gt;→ user→user &#39;interacted_with&#39; edges (count + kinds)&lt;br&gt;&lt;i&gt;Add new .sql files here for new projections&lt;/i&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;html=1;" parent="42" vertex="1">
          <mxGeometry x="400" y="35" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="45" value="Exporters · stages/exporters/" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;fontColor=#333333;" parent="36" vertex="1">
          <mxGeometry x="10" y="710" width="770" height="180" as="geometry" />
        </mxCell>
        <mxCell id="46" value="&lt;b&gt;GmlExporter&lt;/b&gt; (functional)&lt;br&gt;Streams GML plain-text to any BinaryIO sink&lt;br&gt;node [ id &lt;int&gt;  label &lt;str&gt;  type &lt;str&gt; ]&lt;br&gt;edge [ source &lt;int&gt;  target &lt;int&gt;  label &lt;str&gt; ]&lt;br&gt;Computes SHA-256 content hash while writing&lt;br&gt;Returns ExportReceipt(format, hash, counts)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;html=1;" parent="45" vertex="1">
          <mxGeometry x="10" y="35" width="370" height="135" as="geometry" />
        </mxCell>
        <mxCell id="47" value="GraphMlExporter · GexfExporter&lt;br&gt;ParquetExporter · JsonLdExporter · DotExporter&lt;br&gt;&lt;br&gt;&lt;i&gt;Stubs — raise NotImplementedError.&lt;br&gt;Register entry-point only after tests land.&lt;/i&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;html=1;dashed=1;" parent="45" vertex="1">
          <mxGeometry x="395" y="35" width="365" height="135" as="geometry" />
        </mxCell>
        <mxCell id="83" value="" style="edgeStyle=orthogonalEdgeStyle;" parent="36" source="38" target="39" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="84" value="model_name selects SQL file" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;html=1;" parent="36" source="43" target="44" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="48" value="External" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="20" y="1115" width="2020" height="180" as="geometry" />
        </mxCell>
        <mxCell id="49" value="&lt;b&gt;network.duckdb&lt;/b&gt;&lt;br&gt;All datasets in one file&lt;br&gt;Partitioned by dataset_id&lt;br&gt;Shared by DuckDBStore (rw)&lt;br&gt;and DbtProjection (views + rw)&lt;br&gt;Opened read-only for fingerprinting" style="shape=cylinder3;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;html=1;" parent="48" vertex="1">
          <mxGeometry x="20" y="35" width="280" height="135" as="geometry" />
        </mxCell>
        <mxCell id="50" value="&lt;b&gt;dbt CLI&lt;/b&gt;&lt;br&gt;dbt-core + dbt-duckdb&lt;br&gt;Invoked via subprocess&lt;br&gt;by DbtProjection._invoke_dbt()&lt;br&gt;stdout captured → DEBUG log&lt;br&gt;stderr → ERROR log on failure" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;html=1;" parent="48" vertex="1">
