<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram name="hinge — Compact Architecture" id="hinge-compact">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ─── FRONTENDS ──────────────────────────────────────────────── -->
        <mxCell id="10" value="Frontends" style="swimlane;startSize=25;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1360" height="95" as="geometry" />
        </mxCell>

        <mxCell id="11" value="&lt;b&gt;CLI · Typer&lt;/b&gt;&lt;br&gt;hin ingest &lt;file&gt; --reader &lt;name&gt;&lt;br&gt;hin export --dataset &lt;id&gt; --projection &lt;p&gt; --format &lt;f&gt;&lt;br&gt;hin list  datasets / readers / projections / exporters" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;html=1;" vertex="1" parent="10">
          <mxGeometry x="10" y="30" width="330" height="55" as="geometry" />
        </mxCell>

        <mxCell id="12" value="&lt;b&gt;lib.py · Library facade&lt;/b&gt;&lt;br&gt;hinge.ingest(path, reader) → IngestReport (with dataset_id)&lt;br&gt;hinge.export(projection, dataset_id, fmt, sink) → ExportReceipt&lt;br&gt;hinge.list_datasets()   Loads HINSchema · calls runner" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;html=1;" vertex="1" parent="10">
          <mxGeometry x="355" y="30" width="430" height="55" as="geometry" />
        </mxCell>

        <mxCell id="13" value="&lt;b&gt;TUI · Textual&lt;/b&gt;&lt;br&gt;(stub)" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;html=1;dashed=1;" vertex="1" parent="10">
          <mxGeometry x="800" y="30" width="140" height="55" as="geometry" />
        </mxCell>

        <mxCell id="14" value="&lt;b&gt;Web · FastAPI&lt;/b&gt;&lt;br&gt;(stub)" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;html=1;dashed=1;" vertex="1" parent="10">
          <mxGeometry x="955" y="30" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- ─── CONFIG ─────────────────────────────────────────────────── -->
        <mxCell id="20" value="Config · hinge/config/" style="swimlane;startSize=25;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="140" width="200" height="320" as="geometry" />
        </mxCell>

        <mxCell id="21" value="&lt;b&gt;types.yaml&lt;/b&gt;&lt;br&gt;NodeType · EdgeType values&lt;br&gt;schema_version: 2" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;html=1;" vertex="1" parent="20">
          <mxGeometry x="10" y="35" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="22" value="&lt;b&gt;settings.py&lt;/b&gt;&lt;br&gt;HINGE_STORE_PATH&lt;br&gt;HINGE_LOG_LEVEL&lt;br&gt;HINGE_LOG_FILE" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;html=1;" vertex="1" parent="20">
          <mxGeometry x="10" y="115" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="23" value="&lt;b&gt;logging_setup.py&lt;/b&gt;&lt;br&gt;setup_logging() at CLI start&lt;br&gt;stderr + optional rotating file&lt;br&gt;silences dbt unless DEBUG" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;html=1;" vertex="1" parent="20">
          <mxGeometry x="10" y="205" width="180" height="85" as="geometry" />
        </mxCell>

        <!-- ─── KERNEL ─────────────────────────────────────────────────── -->
        <mxCell id="30" value="hinge.kernel — zero external deps" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="140" width="1140" height="320" as="geometry" />
        </mxCell>

        <mxCell id="31" value="&lt;b&gt;Registry · registry.py&lt;/b&gt;&lt;br&gt;Discovers stage implementations via importlib.metadata.entry_points()&lt;br&gt;Groups: hinge.readers · hinge.stores · hinge.projections · hinge.exporters&lt;br&gt;get_reader/store/projection/exporter(name, **kwargs) → instance&lt;br&gt;list_registered(role) → list[str]" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" vertex="1" parent="30">
          <mxGeometry x="10" y="35" width="555" height="125" as="geometry" />
        </mxCell>

        <mxCell id="32" value="&lt;b&gt;Runner · runner.py&lt;/b&gt;&lt;br&gt;run_ingest(reader, store, schema) → IngestReport&lt;br&gt;  ① dataset_id = uuid4().hex  ② begin_dataset()  ③ validate vs HINSchema&lt;br&gt;  ④ batch-upsert (5 000 elements)  ⑤ finalise_dataset()&lt;br&gt;run_projection(proj, spec, dataset_id) → ProjectedGraphHandle&lt;br&gt;run_export(handle, exporter, sink) → ExportReceipt + snapshot_id" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;html=1;" vertex="1" parent="30">
          <mxGeometry x="575" y="35" width="555" height="125" as="geometry" />
        </mxCell>

        <mxCell id="33" value="&lt;b&gt;Schema:&lt;/b&gt;  NodeType (StrEnum) · EdgeType (StrEnum) · TypedNode · TypedEdge · SchemaViolation · HINSchema.from_yaml() — allows_node/edge() — gates every element in run_ingest&lt;br&gt;&lt;b&gt;Protocols:&lt;/b&gt;  ReaderStage · StoreStage · ProjectionStage · ExporterStage  (structural typing — no inheritance required)" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=middle;fontSize=10;rounded=1;spacingLeft=6;" vertex="1" parent="30">
          <mxGeometry x="10" y="175" width="1120" height="125" as="geometry" />
        </mxCell>

        <!-- ─── PIPELINE STAGES ────────────────────────────────────────── -->
        <mxCell id="40" value="Pipeline — runtime stage execution  (Reader → Store → Projection → Exporter)" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="490" width="1360" height="220" as="geometry" />
        </mxCell>

        <mxCell id="41" value="&lt;b&gt;Reader&lt;/b&gt;&lt;br&gt;&lt;b&gt;NumFocusReader&lt;/b&gt;&lt;br&gt;JSONL · CSV · Parquet&lt;br&gt;ACTION_MAP: action → EdgeType&lt;br&gt;yields TypedNode · TypedEdge&lt;br&gt;  · SchemaViolation" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;html=1;" vertex="1" parent="40">
          <mxGeometry x="10" y="35" width="295" height="170" as="geometry" />
        </mxCell>

        <mxCell id="42" value="&lt;b&gt;Store&lt;/b&gt;&lt;br&gt;&lt;b&gt;DuckDBStore · schema v2&lt;/b&gt;&lt;br&gt;Tables: datasets · nodes · edges&lt;br&gt;All keyed by dataset_id&lt;br&gt;begin / upsert / finalise&lt;br&gt;fingerprint · list_datasets" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;html=1;" vertex="1" parent="40">
          <mxGeometry x="355" y="35" width="295" height="170" as="geometry" />
        </mxCell>

        <mxCell id="43" value="&lt;b&gt;Projection&lt;/b&gt;&lt;br&gt;&lt;b&gt;DbtProjection&lt;/b&gt;&lt;br&gt;Creates active_nodes / active_edges&lt;br&gt;views filtered by dataset_id&lt;br&gt;Runs dbt via subprocess&lt;br&gt;SQL models in models/*.sql" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;html=1;" vertex="1" parent="40">
          <mxGeometry x="700" y="35" width="295" height="170" as="geometry" />
        </mxCell>

        <mxCell id="44" value="&lt;b&gt;Exporter&lt;/b&gt;&lt;br&gt;&lt;b&gt;GmlExporter&lt;/b&gt; (functional)&lt;br&gt;Streams GML to any BinaryIO&lt;br&gt;Content hash + snapshot_id&lt;br&gt;&lt;i&gt;GraphML · GEXF · Parquet&lt;br&gt;JSON-LD · DOT (stubs)&lt;/i&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;html=1;" vertex="1" parent="40">
          <mxGeometry x="1045" y="35" width="305" height="170" as="geometry" />
        </mxCell>

        <!-- Pipeline flow arrows (inside container) -->
        <mxCell id="45" value="TypedNode · TypedEdge" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;html=1;fontStyle=1;" edge="1" source="41" target="42" parent="40">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="46" value="dataset_id" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;html=1;fontStyle=1;" edge="1" source="42" target="43" parent="40">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="47" value="ProjectedGraphHandle" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;html=1;fontStyle=1;" edge="1" source="43" target="44" parent="40">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ─── EXTERNAL ───────────────────────────────────────────────── -->
        <mxCell id="50" value="External" style="swimlane;startSize=25;fillColor=#f5f5f5;strokeColor=#666;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="730" width="1360" height="160" as="geometry" />
        </mxCell>

        <mxCell id="51" value="&lt;b&gt;network.duckdb&lt;/b&gt;&lt;br&gt;Multi-dataset store&lt;br&gt;Partitioned by dataset_id&lt;br&gt;Shared: Store (rw) + Projection (views)" style="shape=cylinder3;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;html=1;" vertex="1" parent="50">
          <mxGeometry x="20" y="35" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="52" value="&lt;b&gt;dbt CLI&lt;/b&gt;&lt;br&gt;dbt-core + dbt-duckdb&lt;br&gt;Subprocess invoked by&lt;br&gt;DbtProjection._invoke_dbt()" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;html=1;" vertex="1" parent="50">
          <mxGeometry x="300" y="35" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="53" value="&lt;b&gt;Dataset files&lt;/b&gt;&lt;br&gt;num_focus/*.jsonl  (2.7 M records)&lt;br&gt;num_focus/dev_slice.jsonl  (dev)&lt;br&gt;tests/fixtures/*.jsonl  (smoke-test)" style="shape=note;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;html=1;" vertex="1" parent="50">
          <mxGeometry x="650" y="35" width="290" height="110" as="geometry" />
        </mxCell>

        <mxCell id="54" value="&lt;b&gt;output/*.gml&lt;/b&gt;&lt;br&gt;Exported typed sub-graph&lt;br&gt;Tagged: content_hash · schema_v&lt;br&gt;snapshot_id (SHA-256)" style="shape=note;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;html=1;" vertex="1" parent="50">
          <mxGeometry x="1000" y="35" width="310" height="110" as="geometry" />
        </mxCell>

        <!-- ─── CROSS-CONTAINER EDGES ──────────────────────────────────── -->

        <!-- Frontends → Kernel -->
        <mxCell id="60" value="calls registry + runner" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;html=1;" edge="1" source="10" target="30" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Config → Kernel -->
        <mxCell id="61" value="types.yaml → HINSchema · settings → HINGE_STORE_PATH" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;html=1;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" source="20" target="30" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Kernel → Pipeline -->
        <mxCell id="62" value="discovers via entry-points · orchestrates via protocols" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;html=1;" edge="1" source="30" target="40" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Reader → Dataset files -->
        <mxCell id="63" value="reads" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;html=1;" edge="1" source="41" target="53" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Store → DuckDB -->
        <mxCell id="64" value="reads / writes" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;html=1;" edge="1" source="42" target="51" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Projection → DuckDB -->
        <mxCell id="65" value="creates views · reads results" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;html=1;" edge="1" source="43" target="51" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Projection → dbt CLI -->
        <mxCell id="66" value="subprocess dbt run" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;html=1;" edge="1" source="43" target="52" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Exporter → Output file -->
        <mxCell id="67" value="streams bytes to" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;html=1;" edge="1" source="44" target="54" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
